[Unit]
Description=Keyboard brightness control for DDC monitor
After=multi-user.target

[Service]
User=redwood
SupplementaryGroups=input i2c
CacheDirectory=ddc-brightness-keys
Environment=XDG_CACHE_HOME=/var/cache/ddc-brightness-keys
ExecStart=/usr/bin/python3 /usr/local/libexec/ddc-brightness-keys.py
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=true

[Install]
WantedBy=multi-user.target
